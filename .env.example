# Copie para .env e ajuste conforme o ambiente. Nunca commite o .env real.

# ---- Fase 1 — Foundation --------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dhf
POSTGRES_USER=dhf
POSTGRES_PASSWORD=dhf

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Se vazio, resolvido a partir de REDIS_HOST/REDIS_PORT/REDIS_DB (ver dhf_shared.config).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# JSON array de origens permitidas no CORS da API.
API_CORS_ORIGINS=["http://localhost:5173"]

# ---- Fase 2 — Storage (Google Drive) --------------------------------------
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---- Fase 4 — Voice Bank ---------------------------------------------------
# ELEVENLABS_API_KEY=
# CHATTERBOX_API_URL=

# ---- Fase 5 — Director AI ---------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Fase 6 — GPU Engine (somente no nó Hostinger) -------------------------
# NVIDIA_VISIBLE_DEVICES=all
