# gpu-engine.example.env — copie para gpu-engine.env (fora do Git) e ajuste.
# Consumido por services/gpu_engine (dhf_gpu_engine) e pelos scripts de infra/gpu/.
# Nunca commitar gpu-engine.env com valores reais de produção.

# ---- Hot storage local (seção 22 da missão) -----------------------------------------
DHVF_HOME=/opt/dhvf
DHVF_MODELS_DIR=${DHVF_HOME}/models
DHVF_CACHE_DIR=${DHVF_HOME}/cache
DHVF_ASSETS_DIR=${DHVF_HOME}/assets
DHVF_PROJECTS_DIR=${DHVF_HOME}/projects
DHVF_RENDERS_DIR=${DHVF_HOME}/renders
DHVF_TMP_DIR=${DHVF_HOME}/tmp
DHVF_LOGS_DIR=${DHVF_HOME}/logs

# ---- VRAM Manager (seção 18) — RTX 4090 tem 24576 MiB no total ----------------------
GPU_VRAM_TOTAL_MB=24576
# Percentual de VRAM usada a partir do qual o status vira WARNING (não bloqueia nada,
# só sinaliza no health/telemetria).
GPU_VRAM_WARNING_PCT=80
# Percentual a partir do qual novas alocações (Model Manager) são recusadas por
# padrão — existe margem entre isso e 100% porque o driver/contexto CUDA em si já
# consome uma fatia antes de qualquer modelo ser carregado.
GPU_VRAM_CRITICAL_PCT=92

# ---- Disk (seção 24) — 500GB SSD local ----------------------------------------------
DISK_WARNING_FREE_PCT=20
DISK_CRITICAL_FREE_PCT=8

# ---- Audio2Face-3D (NIM) — ver infra/gpu/audio2face/preflight.sh ---------------------
# NGC_API_KEY=                 # nunca commitar valor real — ver GOOGLE_DRIVE_ACTIVATION.md
                                # para o mesmo princípio aplicado a outra credencial
# AUDIO2FACE_NIM_ENDPOINT=http://localhost:8021

# ---- Relatórios (seção 35) -----------------------------------------------------------
GPU_ENGINE_REPORTS_DIR=infra/gpu/reports
GPU_ENGINE_RESULTS_FILE=/tmp/gpu-engine-results.jsonl
