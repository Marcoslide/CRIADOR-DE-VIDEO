# Copie para .env e ajuste conforme o ambiente. Nunca commite o .env real.
#
# PRODUÇÃO: NÃO copie este arquivo direto. As credenciais abaixo (POSTGRES_PASSWORD em
# especial) são só para desenvolvimento local — o .env de produção precisa ser escrito à
# mão (ou vir de um secret manager) com valores reais, nunca os deste template. O
# docker-compose.prod.yml recusa subir sem POSTGRES_USER/PASSWORD/DB definidos
# (${VAR:?...}), mas não tem como saber se um valor foi "definido de verdade" ou só
# copiado daqui sem trocar — a responsabilidade de não fazer isso é de quem opera o deploy.

# ---- Fase 1 — Foundation --------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dhf
POSTGRES_USER=dhf
# DEV ONLY — nunca use este valor em produção (ver aviso no topo do arquivo).
POSTGRES_PASSWORD=dhf
# DATABASE_CONNECT_TIMEOUT_S=5

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_CONNECT_TIMEOUT_S=2
# REDIS_SOCKET_TIMEOUT_S=5

# Se vazio, resolvido a partir de REDIS_HOST/REDIS_PORT/REDIS_DB (ver dhf_shared.config).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Tempo de retenção do resultado e do marcador de existência do job diagnóstico.
DIAGNOSTIC_JOB_TTL_S=86400

# JSON array de origens permitidas no CORS da API.
API_CORS_ORIGINS=["http://localhost:5173"]

# ---- Fase 2 — Storage (Google Drive) --------------------------------------
# Pasta raiz oficial "CRIADOR DE VIDEO" no Drive — não é segredo, é só um identificador
# (https://drive.google.com/drive/folders/13BTUf5Oyp8fb_CT2H0OJ6LeuZKzm3pxE). Sem uma das
# duas credenciais abaixo, o Storage reporta NOT_CONFIGURED honestamente — nunca simula
# conexão. Ver docs/STORAGE_GOOGLE_DRIVE.md.
GOOGLE_DRIVE_ROOT_FOLDER_ID=13BTUf5Oyp8fb_CT2H0OJ6LeuZKzm3pxE

# Exatamente UMA das duas a seguir (nunca as duas, nunca commitadas com valor real):
#   - _JSON: conteúdo inteiro do JSON da service account, numa linha só (produção via
#     variável de ambiente/secret manager — não escreve nada em disco).
#   - _FILE: caminho local para o arquivo .json da service account (dev local).
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=

# Opcionais — todos têm default sensato (ver dhf_storage.config.GoogleDriveSettings).
# GOOGLE_DRIVE_REQUEST_TIMEOUT_S=30
# GOOGLE_DRIVE_UPLOAD_CHUNK_SIZE_BYTES=8388608
# GOOGLE_DRIVE_DOWNLOAD_CHUNK_SIZE_BYTES=8388608
# GOOGLE_DRIVE_MAX_RETRIES=5
# GOOGLE_DRIVE_RETRY_BASE_DELAY_S=1.0
# GOOGLE_DRIVE_STATUS_CACHE_TTL_S=30

# ---- Fase 4 — Voice Bank ---------------------------------------------------
# ELEVENLABS_API_KEY=
# CHATTERBOX_API_URL=

# ---- Fase 5 — Director AI ---------------------------------------------------
# Sem chave, GET /status/system reporta openai.status=not_configured honestamente. Com
# chave, o check faz uma chamada real (barata) a api.openai.com/v1/models — nunca assume
# que a chave é válida sem checar.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Fase 6 — GPU Engine (somente no nó Hostinger) -------------------------
# Detecção real via `nvidia-smi` (sem variável própria — basta o binário estar no PATH do
# host/container). Sem GPU provisionada, GET /status/system reporta gpu.status=not_configured.
# NVIDIA_VISIBLE_DEVICES=all

# ---- Fase 7 — Unreal / Audio2Face / MetaHuman (engines de render) ----------
# Cada um só existe como interface/checagem de status por enquanto (GET /status/system
# reporta not_installed sem o valor configurado, error se o caminho local configurado não
# existir no disco). A integração funcional (rodar um job real no engine) entra na fase
# que a implementa.
# UNREAL_ENGINE_PATH=
# AUDIO2FACE_PATH=
# METAHUMAN_API_URL=
